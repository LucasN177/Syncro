@page "/reset-password"

<MudPaper Elevation="0" Class="pa-6 mx-auto" Style="max-width: 480px; margin-top: 70px; border-radius: 16px; border: 1px solid var(--mud-palette-divider); background: var(--mud-palette-surface);">
    <MudStack Spacing="4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudAvatar Size="Size.Large" Color="Color.Primary" Style="font-weight: 800;">S</MudAvatar>
            <MudStack Spacing="0">
                <MudText Typo="Typo.h5" Style="font-weight: 800; letter-spacing: -0.5px;">Neues Passwort</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Lege ein neues Passwort für dein Konto fest.</MudText>
            </MudStack>
        </MudStack>

        @if (_isLoading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (_isDone)
        {
            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined">Dein Passwort wurde geändert. Du bist angemeldet.</MudAlert>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="" Style="border-radius: 10px; font-weight: 700;">
                Zum Dashboard
            </MudButton>
        }
        else if (!AuthService.IsAuthenticated)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                @(_linkError ?? "Der Link ist ungültig oder abgelaufen. Fordere über „Passwort vergessen?“ im Anmeldedialog einen neuen an.")
            </MudAlert>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="" Style="border-radius: 10px; font-weight: 700;">
                Zur Startseite
            </MudButton>
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Dense="true" Variant="Variant.Outlined">@_errorMessage</MudAlert>
            }
            <MudText Typo="Typo.body2" Color="Color.Secondary">Konto: @AuthService.CurrentUser?.Email</MudText>
            <MudTextField @bind-Value="_newPassword" Label="Neues Passwort" Variant="Variant.Outlined"
                          InputType="InputType.Password" HelperText="Mindestens 8 Zeichen" />
            <MudTextField @bind-Value="_confirmPassword" Label="Passwort wiederholen" Variant="Variant.Outlined"
                          InputType="InputType.Password" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth="true"
                       Disabled="@_isSaving" OnClick="SavePassword" Style="border-radius: 10px; font-weight: 750;">
                @(_isSaving ? "Speichert …" : "Passwort speichern")
            </MudButton>
        }
    </MudStack>
</MudPaper>
