@page "/projects"

    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-6" Style="flex-wrap: wrap; gap: 16px; margin-top: 50px">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4" Style="font-weight: 800; letter-spacing: -1px;">Projekte</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @_projects.Count Projekt@(_projects.Count == 1 ? string.Empty : "e") in deinem Workspace
            </MudText>
        </MudStack>

        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                   OnClick="CreateProject" Style="border-radius: 10px; font-weight: 700;">
            Neues Projekt
        </MudButton>
    </MudStack>

    @if (_isLoading)
    {
        <MudStack AlignItems="AlignItems.Center" Class="py-12">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        </MudStack>
    }
    else
    {
        <MudGrid Spacing="4">
            @foreach (var project in _projects)
            {
                <MudItem xs="12" sm="6" lg="4">
                    <MudPaper Elevation="0" Class="pa-5" @onclick="@(() => EditProject(project))"
                              Style="height: 100%; border-radius: 16px; border: 1px solid var(--mud-palette-divider); cursor: pointer; transition: box-shadow 0.2s;">
                        <MudStack Spacing="3">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <MudAvatar Size="Size.Medium" Style="@($"background: {project.Color}; color: white; font-weight: 800;")">
                                    @ProjectInitials(project.Name)
                                </MudAvatar>
                                <MudChip T="string" Size="Size.Small" Color="@StatusColor(project.Status)" Variant="Variant.Outlined"
                                         Style="font-weight: 700; border-radius: 8px;">
                                    @project.Status
                                </MudChip>
                            </MudStack>

                            <div>
                                <MudText Typo="Typo.h6" Style="font-weight: 750;">@project.Name</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1"
                                         Style="min-height: 42px; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
                                    @(string.IsNullOrWhiteSpace(project.Description) ? "Noch keine Beschreibung hinterlegt." : project.Description)
                                </MudText>
                            </div>

                            <MudDivider />
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    Erstellt @project.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")
                                </MudText>
                                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" Color="Color.Primary" />
                            </MudStack>
                        </MudStack>
                    </MudPaper>
                </MudItem>
            }

            @if (!_projects.Any())
            {
                <MudItem xs="12">
                    <MudPaper Elevation="0" Class="pa-10" Style="border-radius: 16px; border: 1px dashed var(--mud-palette-divider); text-align: center;">
                        <MudIcon Icon="@Icons.Material.Filled.FolderOpen" Size="Size.Large" Color="Color.Secondary" Class="mb-3" />
                        <MudText Typo="Typo.h6" Style="font-weight: 700;">Noch keine Projekte</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">Lege dein erstes Projekt an, um loszulegen.</MudText>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateProject">Projekt anlegen</MudButton>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    }

    @if (_editingProject is not null)
    {
        <MudOverlay Visible="true" DarkBackground="true" AutoClose="true" OnClosed="CloseEditor" />
        <MudPaper Elevation="12" Class="pa-6" Style="position: fixed; z-index: 1301; right: 24px; top: 88px; width: min(440px, calc(100vw - 32px)); border-radius: 16px;">
            <MudStack Spacing="4">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.h6" Style="font-weight: 750;">@(_editingProject.Id == Guid.Empty ? "Neues Projekt" : "Projekt bearbeiten")</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="CloseEditor" />
                </MudStack>

                <MudTextField @bind-Value="_editingProject.Name" Label="Projektname" Variant="Variant.Outlined" Required="true" />
                <MudTextField @bind-Value="_editingProject.Description" Label="Beschreibung" Variant="Variant.Outlined" Lines="4" />
                <MudSelect T="string" @bind-Value="_editingProject.Status" Label="Status" Variant="Variant.Outlined">
                    <MudSelectItem Value="@("Aktiv")">Aktiv</MudSelectItem>
                    <MudSelectItem Value="@("Pausiert")">Pausiert</MudSelectItem>
                    <MudSelectItem Value="@("Abgeschlossen")">Abgeschlossen</MudSelectItem>
                </MudSelect>
                <MudTextField @bind-Value="_editingProject.Color" Label="Akzentfarbe (Hex)" Variant="Variant.Outlined" />

                <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                    <MudButton Variant="Variant.Text" OnClick="CloseEditor">Abbrechen</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_isSaving" OnClick="SaveProject">
                        @(_isSaving ? "Speichert …" : "Speichern")
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>
    }
