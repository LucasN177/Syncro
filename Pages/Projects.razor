@page "/projects"
@using Syncro.Core.Constants
<RequireAuth>

    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-6" Style="flex-wrap: wrap; gap: 16px; margin-top: 50px">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4" Style="font-weight: 800; letter-spacing: -1px;">Projekte</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @ActiveProjectCount aktive@(ActiveProjectCount == 1 ? "s" : string.Empty) Projekt@(ActiveProjectCount == 1 ? string.Empty : "e") in deinem Workspace
            </MudText>
        </MudStack>

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            @if (_projects.Any(project => project.Status == "Archiviert"))
            {
                <MudSwitch T="bool" @bind-Value="_showArchived" Color="Color.Primary" Label="Archivierte anzeigen" />
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="CreateProject" Style="border-radius: 10px; font-weight: 700;">
                Neues Projekt
            </MudButton>
        </MudStack>
    </MudStack>

    @if (_isLoading)
    {
        <MudStack AlignItems="AlignItems.Center" Class="py-12">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        </MudStack>
    }
    else
    {
        <MudGrid Spacing="4">
            @foreach (var project in VisibleProjects)
            {
                var stats = StatsFor(project.Id);
                var role = RoleFor(project);
                <MudItem xs="12" sm="6" lg="4">
                    <MudPaper Elevation="0" Class="pa-5 project-card" @onclick="@(() => OpenBoard(project))"
                              Style="@($"height: 100%; border-radius: 16px; border: 1px solid var(--mud-palette-divider); border-top: 4px solid {project.Color}; cursor: pointer; opacity: {(project.Status == "Archiviert" ? "0.65" : "1")};")">
                        <MudStack Spacing="3">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudAvatar Size="Size.Medium" Style="@($"background: {project.Color}; color: white; font-weight: 800; font-size: 0.8rem;")">
                                        @ProjectInitials(project)
                                    </MudAvatar>
                                    <MudChip T="string" Size="Size.Small" Color="@StatusColor(project.Status)" Variant="Variant.Outlined"
                                             Style="font-weight: 700; border-radius: 8px;">
                                        @project.Status
                                    </MudChip>
                                    @if (!IsOwner(project))
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                                 Style="font-weight: 600; border-radius: 8px;">
                                            @ProjectRoles.DisplayName(role ?? ProjectRoles.Viewer)
                                        </MudChip>
                                    }
                                </MudStack>

                                <div @onclick:stopPropagation="true">
                                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true"
                                             AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                                        <MudMenuItem Icon="@Icons.Material.Filled.ViewKanban" OnClick="@(() => OpenBoard(project))">
                                            Board öffnen
                                        </MudMenuItem>
                                        @if (role == ProjectRoles.Admin)
                                        {
                                            <MudMenuItem Icon="@Icons.Material.Outlined.Edit" OnClick="@(() => EditProject(project))">
                                                Bearbeiten
                                            </MudMenuItem>
                                            <MudMenuItem Icon="@(project.Status == "Archiviert" ? Icons.Material.Outlined.Unarchive : Icons.Material.Outlined.Archive)"
                                                         OnClick="@(() => ToggleArchived(project))">
                                                @(project.Status == "Archiviert" ? "Reaktivieren" : "Archivieren")
                                            </MudMenuItem>
                                        }
                                    </MudMenu>
                                </div>
                            </MudStack>

                            <div>
                                <MudStack Row="true" AlignItems="AlignItems.Baseline" Spacing="2">
                                    <MudText Typo="Typo.h6" Style="font-weight: 750;">@project.Name</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-family: monospace;">@project.Key</MudText>
                                </MudStack>
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1"
                                         Style="min-height: 42px; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
                                    @(string.IsNullOrWhiteSpace(project.Description) ? "Noch keine Beschreibung hinterlegt." : project.Description)
                                </MudText>
                            </div>

                            <div>
                                <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mb-1">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @stats.Open offen · @stats.Done erledigt
                                    </MudText>
                                    <MudText Typo="Typo.caption" Style="font-weight: 700;">@stats.Percent %</MudText>
                                </MudStack>
                                <MudProgressLinear Value="@stats.Percent" Rounded="true" Size="Size.Small"
                                                   Style="@($"--mud-palette-primary: {project.Color};")" />
                            </div>

                            <MudDivider />
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    Erstellt am @project.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")
                                </MudText>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudText Typo="Typo.caption" Color="Color.Primary" Style="font-weight: 700;">Zum Board</MudText>
                                    <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" Color="Color.Primary" />
                                </MudStack>
                            </MudStack>
                        </MudStack>
                    </MudPaper>
                </MudItem>
            }

            @if (!VisibleProjects.Any())
            {
                <MudItem xs="12">
                    <MudPaper Elevation="0" Class="pa-10" Style="border-radius: 16px; border: 1px dashed var(--mud-palette-divider); text-align: center;">
                        <MudIcon Icon="@Icons.Material.Filled.FolderOpen" Size="Size.Large" Color="Color.Secondary" Class="mb-3" />
                        <MudText Typo="Typo.h6" Style="font-weight: 700;">Noch keine Projekte</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">Lege dein erstes Projekt an, um loszulegen.</MudText>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateProject">Projekt anlegen</MudButton>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    }

</RequireAuth>
