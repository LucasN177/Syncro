@using Syncro.Core.Constants
@using Syncro.Core.Mapping
@using Syncro.Layout.Helper

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            @if (!IsNew)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Style="font-family: monospace; font-weight: 700;">
                    @Issue.ToIssueKey(ProjectKey)
                </MudChip>
            }
            <MudText Typo="Typo.h6" Style="font-weight: 750;">@(IsNew ? "Neues Issue" : CanEdit ? "Issue bearbeiten" : "Issue")</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3" Class="pt-1">
            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Dense="true" Variant="Variant.Outlined">@_errorMessage</MudAlert>
            }

            <MudTextField @bind-Value="Issue.Title" Label="Titel" Variant="Variant.Outlined" Required="true"
                          ReadOnly="@(!CanEdit)" MaxLength="200" />

            <MudTextField @bind-Value="Issue.Description" Label="Beschreibung" Variant="Variant.Outlined" Lines="4"
                          ReadOnly="@(!CanEdit)" />

            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudSelect T="string" @bind-Value="Issue.Type" Label="Typ" Variant="Variant.Outlined" ReadOnly="@(!CanEdit)">
                        @foreach (var type in IssueOptions.Types)
                        {
                            <MudSelectItem Value="@type">@IssueOptions.TypeDisplayName(type)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="string" @bind-Value="Issue.Priority" Label="Priorität" Variant="Variant.Outlined" ReadOnly="@(!CanEdit)">
                        @foreach (var priority in IssueOptions.Priorities)
                        {
                            <MudSelectItem Value="@priority">@IssueOptions.PriorityDisplayName(priority)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="string" @bind-Value="Issue.Status" Label="Spalte" Variant="Variant.Outlined" ReadOnly="@(!CanEdit)">
                        @foreach (var column in BoardColumns.Create())
                        {
                            <MudSelectItem Value="@column.Id.ToStatus()">@column.Id.ToDisplayName()</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="Guid?" @bind-Value="Issue.AssigneeId" Label="Zugewiesen an" Variant="Variant.Outlined"
                               ReadOnly="@(!CanEdit)" ToStringFunc="@AssigneeName">
                        <MudSelectItem Value="@((Guid?)null)">Nicht zugewiesen</MudSelectItem>
                        @foreach (var member in Members.Where(member => member.CanEdit || member.UserId == Issue.AssigneeId))
                        {
                            <MudSelectItem Value="@((Guid?)member.UserId)">@member.DisplayName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="Issue.DueDate" Label="Fällig am" Variant="Variant.Outlined"
                                   DateFormat="dd.MM.yyyy" Clearable="true" ReadOnly="@(!CanEdit)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField T="int?" @bind-Value="Issue.Progress" Label="Fortschritt (%)" Variant="Variant.Outlined"
                                     Min="0" Max="100" Step="10" Clearable="true" ReadOnly="@(!CanEdit)" />
                </MudItem>
            </MudGrid>

            <MudTextField @bind-Value="_tagsText" Label="Tags" HelperText="Mehrere Tags mit Komma trennen"
                          Variant="Variant.Outlined" ReadOnly="@(!CanEdit)" />

            @if (!IsNew)
            {
                <MudDivider Class="my-2" />
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Outlined.AttachFile" Size="Size.Small" Color="Color.Secondary" />
                        <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">Anhänge (@_attachments.Count)</MudText>
                    </MudStack>
                    @if (CanEdit)
                    {
                        <MudFileUpload T="IBrowserFile" FilesChanged="UploadAttachmentAsync" Disabled="@_isUploading"
                                       MaxFileSize="@Services.IssueService.MaxAttachmentBytes">
                            <CustomContent>
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Upload"
                                           Disabled="@_isUploading" OnClick="@context.OpenFilePickerAsync"
                                           Style="border-radius: 8px; font-weight: 700;">
                                    @(_isUploading ? "Lädt hoch …" : "Datei anhängen")
                                </MudButton>
                            </CustomContent>
                        </MudFileUpload>
                    }
                </MudStack>

                @if (_isUploading)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Size="Size.Small" />
                }

                @foreach (var attachment in _attachments)
                {
                    <MudPaper Elevation="0" Class="px-3 py-2" Style="border-radius: 10px; border: 1px solid var(--mud-palette-divider);">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Style="min-width: 0;">
                                <MudIcon Icon="@AttachmentIcon(attachment)" Size="Size.Small" Color="Color.Primary" />
                                <MudStack Spacing="0" Style="min-width: 0;">
                                    <MudLink OnClick="@(() => OpenAttachmentAsync(attachment))" Typo="Typo.body2"
                                             Style="font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; cursor: pointer;">
                                        @attachment.FileName
                                    </MudLink>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @FormatSize(attachment.SizeBytes) · @(MemberFor(attachment.UploadedBy)?.DisplayName ?? "Ehemaliges Mitglied") · @attachment.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")
                                    </MudText>
                                </MudStack>
                            </MudStack>
                            @if (CanEdit)
                            {
                                <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small"
                                               OnClick="@(() => DeleteAttachmentAsync(attachment))" />
                            }
                        </MudStack>
                    </MudPaper>
                }

                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2">
                    <MudIcon Icon="@Icons.Material.Outlined.ChatBubbleOutline" Size="Size.Small" Color="Color.Secondary" />
                    <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">Kommentare (@_comments.Count)</MudText>
                </MudStack>

                @if (_isLoadingComments)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Size="Size.Small" />
                }

                @foreach (var comment in _comments)
                {
                    var author = MemberFor(comment.UserId);
                    <MudPaper Elevation="0" Class="pa-3" Style="border-radius: 10px; border: 1px solid var(--mud-palette-divider);">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudAvatar Size="Size.Small" Style="@($"background: {author?.AvatarColor ?? "#64748b"}; color: white; font-size: 0.6rem; font-weight: 700; width: 22px; height: 22px;")">
                                    @StyleHelper.GetInitials(author?.DisplayName)
                                </MudAvatar>
                                <MudText Typo="Typo.body2" Style="font-weight: 700;">@(author?.DisplayName ?? "Ehemaliges Mitglied")</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @comment.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                </MudText>
                            </MudStack>
                            @if (CanDeleteComment(comment))
                            {
                                <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small"
                                               OnClick="@(() => DeleteCommentAsync(comment))" />
                            }
                        </MudStack>
                        <MudText Typo="Typo.body2" Style="white-space: pre-wrap;">@comment.Body</MudText>
                    </MudPaper>
                }

                @if (CanEdit)
                {
                    <MudStack Row="true" AlignItems="AlignItems.End" Spacing="2">
                        <MudTextField @bind-Value="_newComment" Label="Kommentar schreiben" Variant="Variant.Outlined"
                                      Lines="2" Immediate="true" Style="flex: 1;" HelperText="@MentionHint" />
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@(_isBusy || string.IsNullOrWhiteSpace(_newComment))"
                                   OnClick="AddCommentAsync" Style="border-radius: 8px; font-weight: 700; margin-bottom: 4px;">
                            Senden
                        </MudButton>
                    </MudStack>
                }
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        @if (CanEdit && !IsNew)
        {
            <MudButton Color="Color.Error" Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.Delete"
                       Disabled="@_isBusy" OnClick="DeleteAsync">
                Löschen
            </MudButton>
        }
        <MudSpacer />
        <MudButton Variant="Variant.Text" OnClick="Close">@(CanEdit ? "Abbrechen" : "Schließen")</MudButton>
        @if (CanEdit)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_isBusy" OnClick="SaveAsync"
                       Style="border-radius: 8px; font-weight: 700;">
                @(_isBusy ? "Speichert …" : "Speichern")
            </MudButton>
        }
    </DialogActions>
</MudDialog>
