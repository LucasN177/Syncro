@page "/"
@using Syncro.Core.Constants
@using Syncro.Core.Mapping
@using Syncro.Layout.Helper

    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-6" Style="margin-top: 50px; flex-wrap: wrap; gap: 16px;">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4" Style="font-weight: 800; letter-spacing: -1px;">Dashboard</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @(IsAuthenticated ? $"Willkommen zurück, {DisplayName}" : "Dein zentraler Überblick für Projekte und Aufgaben") · @DateTime.Today.ToString("dddd, dd. MMMM")
            </MudText>
        </MudStack>
        @if (IsAuthenticated)
        {
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <MudIconButton Icon="@Icons.Material.Outlined.Refresh" Size="Size.Small" OnClick="LoadDashboard"
                               Disabled="@_isLoading" aria-label="Aktualisieren" />
                <MudButton Variant="Variant.Outlined" Size="Size.Small"
                           StartIcon="@Icons.Material.Outlined.FileDownload"
                           Disabled="@(!_issues.Any())" OnClick="ExportCsv"
                           Style="border-radius: 10px; font-weight: 700;">
                    Issues exportieren
                </MudButton>
            </MudStack>
        }
    </MudStack>

    <MudPaper Elevation="0" Class="pa-5 mb-6"
              Style="border-radius: 16px; background: linear-gradient(120deg, #0f766e 0%, #0f5f70 55%, #2563eb 100%); color: white; overflow: hidden;">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Style="flex-wrap: wrap; gap: 20px;">
            <MudStack Spacing="1">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudAvatar Color="Color.Default" Style="background: rgba(255,255,255,.18); color: white; font-weight: 800;">
                        @(IsAuthenticated ? StyleHelper.GetInitials(DisplayName) : "S")
                    </MudAvatar>
                    <MudText Typo="Typo.h5" Style="font-weight: 800;">
                        @(IsAuthenticated ? $"Schön, dass du da bist, {DisplayName}." : "Willkommen bei Syncro.")
                    </MudText>
                </MudStack>
                <MudText Typo="Typo.body2" Style="color: rgba(255,255,255,.82); max-width: 620px;">
                    @HeroText
                </MudText>
            </MudStack>
            @if (!IsAuthenticated)
            {
                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Filled" Color="Color.Default" OnClick="@(() => OpenAuthDialogAsync(false))"
                               Style="background: white; color: #0f766e; border-radius: 10px; font-weight: 750;">
                        Anmelden
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Inherit" OnClick="@(() => OpenAuthDialogAsync(true))"
                               Style="border-color: rgba(255,255,255,.65); color: white; border-radius: 10px; font-weight: 750;">
                        Registrieren
                    </MudButton>
                </MudStack>
            }
            else if (!_projects.Any() && !_isLoading)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Default" Href="projects"
                           Style="background: white; color: #0f766e; border-radius: 10px; font-weight: 750;">
                    Erstes Projekt anlegen
                </MudButton>
            }
        </MudStack>
    </MudPaper>

@if (IsAuthenticated)
{
    @if (_isLoading && !_issues.Any())
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-6" />
    }

    <MudGrid Spacing="4" Class="mb-6">
        @foreach (var kpi in Kpis)
        {
            <MudItem xs="12" sm="6" lg="3">
                <MudPaper Elevation="0" Class="pa-5"
                          Style="border-radius: 16px; border: 1px solid var(--mud-palette-divider); background: var(--mud-palette-surface); height: 100%;">
                    <MudStack Spacing="3">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Style="font-weight: 600;">
                                @kpi.Label
                            </MudText>
                            <MudAvatar Style="@($"background: {kpi.Hex}18; width: 38px; height: 38px;")">
                                <MudIcon Icon="@kpi.Icon" Style="@($"color: {kpi.Hex}; font-size: 18px;")" />
                            </MudAvatar>
                        </MudStack>
                        <MudStack Spacing="0">
                            <MudText Style="font-size: 2rem; font-weight: 800; letter-spacing: -1px; line-height: 1;">
                                @kpi.Value
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">@kpi.Hint</MudText>
                        </MudStack>
                        <MudProgressLinear Value="@kpi.Progress" Rounded="true" Size="Size.Small"
                                           Style="@($"--mud-palette-primary: {kpi.Hex};")" />
                    </MudStack>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>

    <MudGrid Spacing="4" Class="mb-4">

        <MudItem xs="12" lg="8">
            <MudPaper Elevation="0" Class="pa-5"
                      Style="border-radius: 16px; border: 1px solid var(--mud-palette-divider); background: var(--mud-palette-surface); height: 100%;">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h6" Style="font-weight: 700;">Meine Aufgaben</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Offene Issues, die dir zugewiesen sind</MudText>
                    </MudStack>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" Style="font-weight: 700;">
                        @MyIssues.Count()
                    </MudChip>
                </MudStack>

                @if (!MyIssues.Any())
                {
                    <MudStack AlignItems="AlignItems.Center" Class="py-8">
                        <MudIcon Icon="@Icons.Material.Outlined.TaskAlt" Size="Size.Large" Color="Color.Success" />
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Keine offenen Aufgaben – stark!</MudText>
                    </MudStack>
                }

                <MudStack Spacing="1">
                    @foreach (var issue in MyIssues.Take(8))
                    {
                        var project = ProjectFor(issue.ProjectId);
                        var column = issue.Status.ToColumn();
                        var isOverdue = issue.DueDate is { } due && due.Date < DateTime.Today;
                        <MudPaper Elevation="0" Class="pa-3 project-card" @onclick="@(() => OpenBoard(issue.ProjectId))"
                                  Style="@($"border-radius: 10px; border-left: 4px solid {project?.Color ?? "#0f766e"}; background: var(--mud-palette-background); cursor: pointer;")">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Style="min-width: 0;">
                                    <MudText Typo="Typo.caption" Style="font-family: monospace; font-weight: 700; white-space: nowrap;">
                                        @issue.ToIssueKey(project?.Key)
                                    </MudText>
                                    <MudIcon Icon="@StyleHelper.GetPriorityIcon(issue.Priority)" Color="@StyleHelper.GetPriorityColor(issue.Priority)" Size="Size.Small" />
                                    <MudText Typo="Typo.body2" Style="font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                        @issue.Title
                                    </MudText>
                                </MudStack>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Style="flex-shrink: 0;">
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                             Style="font-size: 0.65rem; height: 20px; border-radius: 6px;">
                                        @column.ToDisplayName()
                                    </MudChip>
                                    @if (issue.DueDate is { } dueDate)
                                    {
                                        <MudText Typo="Typo.caption" Color="@(isOverdue ? Color.Error : Color.Secondary)"
                                                 Style="@($"min-width: 72px; text-align: right; {(isOverdue ? "font-weight: 700;" : string.Empty)}")">
                                            @dueDate.ToString("dd.MM.yyyy")
                                        </MudText>
                                    }
                                </MudStack>
                            </MudStack>
                        </MudPaper>
                    }
                    @if (MyIssues.Count() > 8)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                            und @(MyIssues.Count() - 8) weitere auf den Boards
                        </MudText>
                    }
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" lg="4">
            <MudPaper Elevation="0" Class="pa-5"
                      Style="border-radius: 16px; border: 1px solid var(--mud-palette-divider); background: var(--mud-palette-surface); height: 100%;">
                <MudStack Spacing="0" Class="mb-4">
                    <MudText Typo="Typo.h6" Style="font-weight: 700;">Team-Auslastung</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Offene Issues pro Person</MudText>
                </MudStack>
                @if (!Workload.Any())
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Noch keine Issues zugewiesen.</MudText>
                }
                <MudStack Spacing="3">
                    @foreach (var member in Workload)
                    {
                        <MudStack Spacing="1">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudAvatar Size="Size.Small"
                                               Style="@($"background: {member.Hex}; color: white; font-size: 0.68rem; font-weight: 800; width: 28px; height: 28px;")">
                                        @StyleHelper.GetInitials(member.Name)
                                    </MudAvatar>
                                    <MudText Typo="Typo.body2" Style="font-weight: 600;">@member.Name</MudText>
                                </MudStack>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudText Typo="Typo.body2" Style="font-weight: 700;">@member.Open</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">offen</MudText>
                                </MudStack>
                            </MudStack>
                            <MudProgressLinear Value="@(member.Open * 100.0 / Math.Max(1, Workload.Max(m => m.Open)))"
                                               Rounded="true" Size="Size.Small" Style="@($"--mud-palette-primary: {member.Hex};")" />
                        </MudStack>
                    }
                </MudStack>
            </MudPaper>
        </MudItem>

    </MudGrid>

    <MudGrid Spacing="4">

        <MudItem xs="12" lg="4">
            <MudPaper Elevation="0" Class="pa-5"
                      Style="border-radius: 16px; border: 1px solid var(--mud-palette-divider); background: var(--mud-palette-surface); height: 100%;">
                <MudStack Spacing="0" Class="mb-4">
                    <MudText Typo="Typo.h6" Style="font-weight: 700;">Aktivität</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Neueste Änderungen in deinen Projekten</MudText>
                </MudStack>
                @if (!_activities.Any())
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Noch keine Aktivität.</MudText>
                }
                <MudTimeline TimelinePosition="TimelinePosition.Start" TimelineAlign="TimelineAlign.Start">
                    @foreach (var activity in _activities)
                    {
                        var actor = ProfileFor(activity.ActorId);
                        <MudTimelineItem Color="@ActivityColor(activity.Action)" Size="Size.Small" Elevation="0">
                            <ItemContent>
                                <MudStack Spacing="0" Class="mb-3">
                                    <MudText Typo="Typo.body2" Style="font-weight: 600; line-height: 1.4;">@activity.Message</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                                        @(actor?.DisplayName ?? "System") · @(ProjectFor(activity.ProjectId)?.Name) · @TimeHelper.Relative(activity.CreatedAt)
                                    </MudText>
                                </MudStack>
                            </ItemContent>
                        </MudTimelineItem>
                    }
                </MudTimeline>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" lg="4">
            <MudPaper Elevation="0" Class="pa-5"
                      Style="border-radius: 16px; border: 1px solid var(--mud-palette-divider); background: var(--mud-palette-surface); height: 100%;">
                <MudStack Spacing="0" Class="mb-4">
                    <MudText Typo="Typo.h6" Style="font-weight: 700;">Status</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Issues aller Projekte nach Spalte</MudText>
                </MudStack>

                <MudStack AlignItems="AlignItems.Center" Class="mb-4">
                    <svg viewBox="0 0 160 160" style="width:150px;height:150px;">
                        <circle cx="80" cy="80" r="55" fill="none" stroke="var(--mud-palette-lines-default)" stroke-width="22"/>
                        @{
                            var start = 0;
                        }
                        @foreach (var seg in Segments.Where(seg => seg.Count > 0))
                        {
                            <circle cx="80" cy="80" r="55" fill="none" stroke="@seg.Hex" stroke-width="22"
                                    stroke-dasharray="@($"{CalcDash(seg.Count, TotalIssues)} {CalcDash(1, 1)}")"
                                    stroke-dashoffset="@CalcOffset(start, TotalIssues, 55)"
                                    transform="rotate(-90 80 80)"/>
                            start += seg.Count;
                        }
                        @((MarkupString)$"<text x=\"80\" y=\"76\" text-anchor=\"middle\" font-size=\"22\" font-weight=\"800\" fill=\"var(--mud-palette-text-primary)\">{TotalIssues}</text>")
                        @((MarkupString)"<text x=\"80\" y=\"92\" text-anchor=\"middle\" font-size=\"10\" fill=\"#94A3B8\">gesamt</text>")
                    </svg>
                </MudStack>

                <MudStack Spacing="2">
                    @foreach (var seg in Segments)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <div style="@($"width:10px;height:10px;border-radius:3px;background:{seg.Hex};")"></div>
                                <MudText Typo="Typo.body2" Style="font-weight: 600;">@seg.Label</MudText>
                            </MudStack>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudText Typo="Typo.body2" Style="font-weight: 700;">@seg.Count</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Style="min-width:32px;text-align:right;">
                                    @($"{(TotalIssues == 0 ? 0 : seg.Count * 100 / TotalIssues)}%")
                                </MudText>
                            </MudStack>
                        </MudStack>
                    }
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" lg="4">
            <MudPaper Elevation="0" Class="pa-5"
                      Style="border-radius: 16px; border: 1px solid var(--mud-palette-divider); background: var(--mud-palette-surface); height: 100%;">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h6" Style="font-weight: 700;">Demnächst</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Termine der nächsten 14 Tage</MudText>
                    </MudStack>
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" Href="calendar"
                               Style="font-weight: 700; font-size: 0.7rem;">
                        Alle anzeigen
                    </MudButton>
                </MudStack>
                @if (!_upcomingEvents.Any())
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Keine anstehenden Termine.</MudText>
                }
                <MudStack Spacing="2">
                    @foreach (var ev in _upcomingEvents)
                    {
                        var category = _categories.FirstOrDefault(c => c.Name == ev.Category);
                        var hex = category?.Hex ?? "#6366F1";
                        <MudPaper Elevation="0" Class="pa-3"
                                  Style="@($"border-radius: 10px; border-left: 4px solid {hex}; background: {hex}0D;")">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.body2" Style="font-weight: 700;">@ev.Title</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@TimeHelper.Upcoming(ev.Start)</MudText>
                                </MudStack>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                         Style="@($"font-size: 0.65rem; font-weight: 700; color: {hex};")">
                                    @CalendarCategories.DisplayName(ev.Category)
                                </MudChip>
                            </MudStack>
                        </MudPaper>
                    }
                </MudStack>
            </MudPaper>
        </MudItem>

    </MudGrid>
}
